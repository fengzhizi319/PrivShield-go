# ==============================================================================
# PrivShield 微服务集群全量环境变量配置模板 (.env.example)
# ==============================================================================
# 使用方式：
#   cp .env.example .env
#   按需修改各服务的监听地址、端口、密钥与安全开关。
#
# 设计原则：全量显式声明（Explicit is better than implicit）
# 所有微服务的网络端口、协议开关、生命周期参数均显式在此列出，禁止隐式默认。

# ==============================================================================
# 1. PrivShield Agent (核心隐私算力与动态分类分级 Sidecar :8079 / :50051)
# ==============================================================================
AGENT_REST_ENABLED=true
AGENT_REST_HOST=0.0.0.0
AGENT_REST_PORT=8079
AGENT_GRPC_ENABLED=true
AGENT_GRPC_HOST=0.0.0.0
AGENT_GRPC_PORT=50051
AGENT_LOG_LEVEL=INFO
AGENT_RATE_LIMIT_RPS=1000
AGENT_RATE_LIMIT_BURST=2000
AGENT_TLS_ENABLED=false
AGENT_REQUIRE_TLS=false
AGENT_TLS_CERT_FILE=
AGENT_TLS_KEY_FILE=
AGENT_TLS_CA_FILE=
AGENT_AUTH_ENABLED=false
AGENT_AUTH_INTERNAL_API_KEYS=
AGENT_AUTH_INTERNAL_MTLS_ENABLED=false
AGENT_AUTH_MTLS_WHITELIST_FILE=
AGENT_SHUTDOWN_DRAIN_SECONDS=5
AGENT_GRPC_GRACEFUL_STOP_SECONDS=15

# ==============================================================================
# 2. PrivShield Gateway (七层反向代理与 P2C-EWMA 负载均衡网关 :8000 / :50000)
# ==============================================================================
ENGINE_GATEWAY_HOST=0.0.0.0
ENGINE_GATEWAY_PORT=8000
ENGINE_GATEWAY_GRPC_HOST=0.0.0.0
ENGINE_GATEWAY_GRPC_PORT=50000
ENGINE_GATEWAY_REQUIRE_TLS=false

# ==============================================================================
# 3. Service Hub (数联数据服务调度中枢 :8082 / :50052)
# ==============================================================================
SERVICE_HUB_HOST=0.0.0.0
SERVICE_HUB_PORT=8082
SERVICE_HUB_GRPC_HOST=0.0.0.0
SERVICE_HUB_GRPC_PORT=50052
SERVICE_HUB_LOG_LEVEL=info
SERVICE_HUB_LOG_FORMAT=json
SERVICE_HUB_TLS_ENABLED=false
SERVICE_HUB_REQUIRE_TLS=false
SERVICE_HUB_API_KEY=
SERVICE_HUB_DB_PATH=/data/service-hub/hub.db
SERVICE_HUB_STRICT_STORAGE=true
SERVICE_HUB_SHUTDOWN_TIMEOUT=5

# ==============================================================================
# 4. Datasource Manager (数据源资产管理与敏感特征自动探查 :8083 / :50053)
# ==============================================================================
DATASOURCE_MGR_HOST=0.0.0.0
DATASOURCE_MGR_PORT=8083
DATASOURCE_MGR_GRPC_HOST=0.0.0.0
DATASOURCE_MGR_GRPC_PORT=50053
DATASOURCE_MGR_TLS_ENABLED=false
DATASOURCE_MGR_REQUIRE_TLS=false
DATASOURCE_MGR_API_KEY=
DATASOURCE_MGR_STRICT_STORAGE=true

# ==============================================================================
# 5. Audit Log (脱敏审计日志与不可篡改 SM3 哈希链存证 :8084 / :50054)
# ==============================================================================
AUDIT_LOG_HOST=0.0.0.0
AUDIT_LOG_PORT=8084
AUDIT_LOG_GRPC_HOST=0.0.0.0
AUDIT_LOG_GRPC_PORT=50054
AUDIT_LOG_TLS_ENABLED=false
AUDIT_LOG_REQUIRE_TLS=false
AUDIT_LOG_API_KEY=
AUDIT_LOG_READER_API_KEY=
AUDIT_LOG_RETENTION_DAYS=0

# ==============================================================================
# 6. Console BFF (统一控制台后端网关 :8081 / :50055)
# ==============================================================================
BFF_HOST=0.0.0.0
BFF_PORT=8081
BFF_STATIC_DIR=../web/dist
BFF_GRPC_ENABLED=false
BFF_GRPC_HOST=0.0.0.0
BFF_GRPC_PORT=50055
BFF_TLS_ENABLED=false
BFF_REQUIRE_TLS=false
BFF_API_KEY=
BFF_RATE_LIMIT=600
BFF_HUB_URL=http://service-hub:8082
BFF_DATASOURCE_URL=http://datasource-mgr:8083
BFF_AUDIT_URL=http://audit-log:8084

# ==============================================================================
# 7. 基础设施、LLM 与外部数据库 (PostgreSQL / Grafana / vLLM)
# ==============================================================================
LLM_API_BASE=http://vllm:8000/v1
LLM_API_KEY=EMPTY
VLLM_IMAGE_TAG=latest
GRAFANA_ADMIN_PASSWORD=admin
PG_USER=privshield
PG_PASSWORD=privshield_dev
