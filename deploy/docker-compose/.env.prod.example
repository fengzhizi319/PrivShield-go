# =============================================================================
# PrivShield Docker Compose 生产环境变量模板 (.env.prod.example)
# =============================================================================
# 生产环境使用说明：
#   1. 复制此文件为 .env:
#      cp .env.prod.example .env
#   2. 下方「启动门禁必填项」全部使用 ${VAR:?...} 声明：任一项留空，对应容器会在
#      启动阶段直接退出（P0-1 零信任默认态），不存在「漏配即静默放行」的中间态。
#   3. 生成强随机密钥（不要把真实值提交到 Git）：
#        openssl rand -hex 32        # 各类 *_API_KEY / token
#        openssl rand -hex 16        # AUDIT_LOG_ENCRYPTION_KEY / AUDIT_LOG_HASH_KEY
#   4. 准备证书文件 deploy/docker-compose/certs/tls.crt 与 tls.key
#   5. 客户端证书身份鉴别依赖 CN 白名单文件（P0-1）：TLS 开启且监听 gRPC 时，
#      PRIVACY_AUTH_MTLS_WHITELIST_FILE 为空即拒绝启动。仓库提供样例
#      config/mtls-whitelist.yaml，生产应换成局方签发的 CN 清单。

# ── 启动门禁必填项（缺失 = 服务拒绝启动）────────────────────────────────────
# 引擎入站 Key，格式 token:name:scope1,scope2;token2:name2:scopes（多把用 ; 分隔）
PRIVACY_AUTH_INTERNAL_API_KEYS=CHANGE_ME_内部服务token:service-hub:mask,dp,classify,read;datasource-mgr:datasource-mgr:mask,read
PRIVACY_AUTH_EXTERNAL_API_KEYS=CHANGE_ME_外部调用方token:consumer-app:mask,dp
# 中台三服务与 BFF 的入站 / 出站 Key（出站值必须与对端入站值一致）
PRIVACY_AGENT_API_KEY=CHANGE_ME_引擎调用Agent出站key
SERVICE_HUB_API_KEY=CHANGE_ME_hub入站key
SERVICE_HUB_DATASOURCE_API_KEY=CHANGE_ME_hub调用数据源管理出站key
DATASOURCE_MGR_API_KEY=CHANGE_ME_数据源管理入站key
AUDIT_LOG_API_KEY=CHANGE_ME_存证入站key
# 存证只读核验员 Key（P1-6 权责分离）：必须与 AUDIT_LOG_API_KEY 不同（相同则 audit-log 拒绝启动）。
# 该 Key 只能命中查询/验真路由（GET logs|stats|snapshots|chain/verify、POST snapshots/verify），
# 任何写入类请求一律 403；不启用只读角色时也要填一个不同的随机值占位。
AUDIT_LOG_READER_API_KEY=CHANGE_ME_存证只读核验key
BFF_HUB_API_KEY=CHANGE_ME_BFF调用hub出站key
BFF_DATASOURCE_API_KEY=CHANGE_ME_BFF调用数据源管理出站key
BFF_AUDIT_API_KEY=CHANGE_ME_BFF调用存证出站key
CONSOLE_API_KEY=CHANGE_ME_控制台入站key
# mTLS 客户端证书 CN 白名单（容器内路径）
PRIVACY_AUTH_MTLS_WHITELIST_FILE=/etc/PrivShield/mtls-whitelist.yaml
# 存证快照加密主密钥（P0-3：缺失将导致密文落盘不可保证而拒绝启动）
AUDIT_LOG_ENCRYPTION_KEY=CHANGE_ME_SM4主密钥_32hex
# 存证哈希链 HMAC-SM3 密钥（P1-2：由局方密码平台托管，轮换后需重签存量行）
AUDIT_LOG_HASH_KEY=CHANGE_ME_链式存证HMAC密钥_32hex
# PostgreSQL 账号（compose 用 ${PG_USER:?}/${PG_PASSWORD:?} 拼接 DSN）
PG_USER=privshield
PG_PASSWORD=CHANGE_ME_StrongPassword123!
# 存证专用账号（可选，默认回落到 PG_USER/PG_PASSWORD）；
# 配合 deploy/sql/audit_writeonly_role.sql 建只写账号后置 AUDIT_LOG_DB_WRITE_ONLY=true。
#PG_AUDIT_USER=privshield_audit
#PG_AUDIT_PASSWORD=CHANGE_ME_StrongAuditPassword123!
# Grafana 管理员密码
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GrafanaStrongPassword123!

# ── 基础服务配置 ────────────────────────────────────────────────────────────
PRIVACY_LOG_LEVEL=INFO
# PRIVACY_LOG_FORMAT 仅 Python 引擎读取；Go 引擎固定 JSON 输出（env-scope: python-engine）
#PRIVACY_LOG_FORMAT=json

# ── 生产安全配置：TLS / 认证 / 限流（Go agent 编排里已硬编码为 true，此处仅备查）──
# 注意：Go agent（engine-go）只读取 AGENT_* 变量名；Python 引擎栈才使用 PRIVACY_* 前缀。
AGENT_TLS_ENABLED=true
AGENT_TLS_CERT_FILE=/certs/tls.crt
AGENT_TLS_KEY_FILE=/certs/tls.key
AGENT_AUTH_ENABLED=true
AGENT_AUTH_INTERNAL_MTLS_ENABLED=true
PRIVACY_RATE_LIMIT_ENABLED=true
PRIVACY_RATE_LIMIT_DEFAULT_RPS=50
PRIVACY_RATE_LIMIT_DEFAULT_BURST=100
PRIVACY_RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# ── 存证留存红线（P0-8：0 = 永不物理删除）────────────────────────────────────
# 置 >0 时必须同时提供 AUDIT_LOG_ARCHIVE_DIR，且不得小于三年留存下限。
AUDIT_LOG_RETENTION_DAYS=0
#AUDIT_LOG_ARCHIVE_DIR=/var/lib/privshield/audit-archive
#AUDIT_LOG_DB_WRITE_ONLY=false

# ── LLM 推理连接（Layer-3 默认关闭，不属于启动门禁项）────────────────────────
# Go 引擎读取 PRIVACY_LLM_ENABLE / PRIVACY_LLM_ENDPOINT / PRIVACY_LLM_MODEL；
# PRIVACY_LLM_PROVIDER 仅 Python 引擎读取（env-scope: python-engine），保留备用。
#PRIVACY_LLM_PROVIDER=vllm
#PRIVACY_LLM_ENABLE=true
# Go 侧端点必须是完整 chat/completions URL（不是 /v1）
#PRIVACY_LLM_ENDPOINT=http://vllm:8000/v1/chat/completions
# 非环回 http:// 端点默认被 P0-5 拒绝；集群内明文 vLLM 才需要显式置 true
#PRIVACY_LLM_ALLOW_INSECURE_HTTP_ENDPOINT=true
#PRIVACY_LLM_MODEL=Qwen3.5-0.8B-Privacy-Classifier-Smoother
LLM_API_BASE=http://vllm:8000/v1
LLM_API_KEY=EMPTY
VLLM_IMAGE_TAG=latest

# ── 监控面板 ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GF_USERS_ALLOW_SIGN_UP=false

# ── Phase B PostgreSQL（多副本 Hub 模式；prod 编排已默认注入 DSN）─────────────
# 启用: docker compose -f docker-compose.prod.yml --profile phase-b up -d
# 如需覆盖内置 DSN，取消注释并改成真实地址：
#SERVICE_HUB_PG_DSN=postgres://privshield:CHANGE_ME@phase-b-postgres:5432/privshield_hub?sslmode=require
#AUDIT_LOG_PG_DSN=postgres://privshield_audit:CHANGE_ME@phase-b-postgres:5432/privshield?sslmode=require
