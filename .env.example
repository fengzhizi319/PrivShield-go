# ==============================================================================
# PrivShield — 运维主控配置入口 / Operations Master Configuration
# ==============================================================================
#
# 本文件是项目根目录的环境变量配置模板。
# This file is the template for the root .env configuration.
#
# 使用方式 / Usage:
#   cp .env.example .env    # 复制为 .env 后按需修改
#
# ┌─ 配置加载顺序 / Cascade Load Order ─────────────────────────────────────────┐
# │  1. 本文件 (.env) — 基础配置                                                │
# │  2. config/env/<PRIVACY_ENV_PROFILE>.env — 场景覆盖（优先级更高）             │
# │  3. 系统环境变量 / Docker environment — 最高优先级                            │
# └──────────────────────────────────────────────────────────────────────────────┘
#
# ┌─ Docker Compose 使用 / Docker Compose Usage ────────────────────────────────┐
# │  docker compose 自动读取项目根目录 .env 进行变量替换。                          │
# │  Agent 服务通过 env_file 指令显式引用 .env。                                  │
# │  生产部署建议：复制本文件 → 修改安全配置 → 不要提交 .env 到 Git。               │
# └──────────────────────────────────────────────────────────────────────────────┘
#
# ┌─ 快速开始 / Quick Start ────────────────────────────────────────────────────┐
# │  本地开发：保持默认即可（所有安全功能关闭）。                                    │
# │  生产部署：取消注释 [生产推荐] 标记的配置项并设置合理值。                         │
# │  切换 LLM 场景：仅需修改 PRIVACY_ENV_PROFILE 一行。                            │
# └──────────────────────────────────────────────────────────────────────────────┘


# ==============================================================================
# 1. 场景 Profile / LLM Backend Profile Selection
# ==============================================================================
# 切换 LLM 推理后端场景，自动级联加载 config/env/<profile>.env。
# Switch the LLM inference backend profile; auto-cascade-loads config/env/<profile>.env.
#
# 可选值 / Options:
#   vllm   — 独立进程 vLLM OpenAI 兼容 HTTP 服务 (config/env/vllm.env)
#   qwen3  — 本地 PyTorch/Transformers 嵌入模式 (config/env/qwen3.env)
#   mlx    — macOS Apple Silicon MLX 引擎模式 (config/env/mlx.env)
#   openai — 外部通用 OpenAI/Ollama API 接口模式 (config/env/openai.env)
PRIVACY_ENV_PROFILE=vllm


# ==============================================================================
# 2. 网络监听 / Network & Listen Settings
# ==============================================================================
# 注意 / Note:
#   - python -m engine.server / grpc_server / launcher
#     默认绑定 0.0.0.0（适合容器/集群部署）。
#   - python -m engine.main 默认绑定 127.0.0.1（仅本地访问）。
#   - 本地开发建议保持 127.0.0.1；容器部署需改为 0.0.0.0 并配合 TLS/Auth。
# ------------------------------------------------------------------------------
# PrivShield Core Agent 网络监听与协议开关（显式全量配置）
AGENT_REST_ENABLED=true
AGENT_REST_HOST=127.0.0.1
AGENT_REST_PORT=8079
AGENT_GRPC_ENABLED=true
AGENT_GRPC_HOST=127.0.0.1
AGENT_GRPC_PORT=50051

# [可选] gRPC 线程池大小 / gRPC thread pool size (default: 64)
# PRIVACY_GRPC_MAX_WORKERS=64

# [可选] REST 并发与请求限制 / REST concurrency & request limits (uvicorn)
# PRIVACY_LIMIT_CONCURRENCY=10000
# PRIVACY_LIMIT_MAX_REQUESTS=100000
# PRIVACY_TIMEOUT_KEEP_ALIVE=30


# ==============================================================================
# 3. 日志与可观测性 / Logging & Observability
# ==============================================================================
# 日志级别 / Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
AGENT_LOG_LEVEL=INFO

# [生产推荐] 日志格式 / Log format: text（开发） 或 json（生产）
# PRIVACY_LOG_FORMAT=json

# 服务名（出现在日志/追踪中）/ Service name in logs/traces
# PRIVACY_SERVICE_NAME=PrivShield

# [可选] OpenTelemetry OTLP 端点 / OTLP endpoint for trace export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317


# ==============================================================================
# 4. 安全配置 / Security — TLS & API Key Authentication & Rate Limiting
# ==============================================================================
# 详见 / See: docs/production_security/ops.md
#
# ┌─ 4.1 TLS 传输加密 / TLS Transport Encryption ──────────────────────────────┐
# │ AGENT_TLS_ENABLED=false          — 启用 TLS（生产必须开启）                    │
# │ AGENT_TLS_CERT_FILE=/certs/tls.crt — 服务端证书路径                          │
# │ AGENT_TLS_KEY_FILE=/certs/tls.key  — 服务端私钥路径                          │
# │ AGENT_TLS_CA_FILE=/certs/ca.crt    — CA 证书（mTLS 时需要）                  │
# └──────────────────────────────────────────────────────────────────────────────┘
AGENT_TLS_ENABLED=false
AGENT_TLS_CERT_FILE=/certs/tls.crt
AGENT_TLS_KEY_FILE=/certs/tls.key
AGENT_TLS_CA_FILE=/certs/ca.crt

# ┌─ 4.2 API Key 认证 / API Key Authentication ────────────────────────────────┐
# │ PRIVACY_AUTH_ENABLED=false       — 启用 API Key 认证（生产必须开启）            │
# │                                                                            │
# │ 外部调用方 Key（JSON 对象）/ External caller keys:                            │
# │   PRIVACY_AUTH_EXTERNAL_KEYS_JSON={"<api-key>":{"name":"svc","scopes":["*"]}}│
# │                                                                            │
# │ 内部服务间 Key（同格式）/ Internal service keys (same format):                 │
# │   PRIVACY_AUTH_INTERNAL_KEYS_JSON=                                           │
# └──────────────────────────────────────────────────────────────────────────────┘
AGENT_AUTH_ENABLED=false
AGENT_AUTH_INTERNAL_API_KEYS=

# ┌─ 4.3 mTLS 内部身份认证 / mTLS Internal Identity Authentication ────────────┐
# │ 默认关闭（fail-closed）：持有合法证书不代表被授权访问。                          │
# │ AGENT_AUTH_INTERNAL_MTLS_ENABLED=false  — 启用 mTLS 客户端证书认证         │
# │                                                                            │
# │ CN 白名单方式一：YAML 配置文件（支持 per-CN scope + 热重载，推荐）               │
# │   AGENT_AUTH_MTLS_WHITELIST_FILE=config/mtls-whitelist.yaml                 │
# └──────────────────────────────────────────────────────────────────────────────┘
AGENT_AUTH_INTERNAL_MTLS_ENABLED=false
AGENT_AUTH_MTLS_WHITELIST_FILE=config/mtls-whitelist.yaml

# ┌─ 4.4 速率限制 / Rate Limiting ─────────────────────────────────────────────┐
# │ AGENT_RATE_LIMIT_ENABLED=false       — 启用速率限制（生产推荐开启）              │
# │ AGENT_RATE_LIMIT_RPS=1000            — 默认每秒请求数                          │
# │ AGENT_RATE_LIMIT_BURST=2000          — 默认突发上限                            │
# └──────────────────────────────────────────────────────────────────────────────┘
AGENT_RATE_LIMIT_ENABLED=false
AGENT_RATE_LIMIT_RPS=1000
AGENT_RATE_LIMIT_BURST=2000

# ┌─ 4.5 健康检查 / Health Check Endpoints ────────────────────────────────────┐
# │ 健康检查端点默认免认证/免限速（K8s 探针依赖）。                                  │
# │ Health endpoints are auth-free and rate-limit-free by default (K8s probes).  │
# └──────────────────────────────────────────────────────────────────────────────┘
# PRIVACY_HEALTH_NO_AUTH=true
# PRIVACY_HEALTH_NO_RATE_LIMIT=true


# ==============================================================================
# 5. 隐私预算与参数 Profile / Privacy Budget & Parameter Profile
# ==============================================================================
# YAML 参数 profile 路径（见 config/sample-privacy-profile.yaml）
# PRIVACY_PROFILE=privacy-profile.yaml

# 个性化推荐参数文件 / Personalized profiles
# PRIVACY_PERSONALIZED_PROFILE=config/personalized-profiles.yaml

# 预算命名空间（多租户隔离）/ Budget namespace for multi-tenant isolation
# PRIVACY_NAMESPACE=default

# [生产推荐] SQLite 预算库路径（多实例部署必须）/ SQLite budget DB (required for multi-instance)
# PRIVACY_BUDGET_DB=privacy_budget.db

# 预算自动重置窗口（秒）/ Auto-reset window in seconds
# PRIVACY_BUDGET_WINDOW_SECONDS=86400

# 预算审计日志 / Audit log path & HMAC key
# PRIVACY_BUDGET_AUDIT_LOG=logs/privacy_budget_audit.log
# PRIVACY_AUDIT_KEY=


# ==============================================================================
# 6. 动态分类分级漏斗 / Dynamic Classification Funnel (Rule → NER → LLM)
# ==============================================================================
# Layer-2 Small-NER 实体识别（需先下载 NER 模型）
# PRIVACY_NER_ENABLE=false

# 显式启用 Layer-3 LLM 层（不启用时仅在低置信/冲突时按策略触发）
# PRIVACY_LLM_ENABLE=false

# 图片/DICOM 输入自动触发多模态 LLM 层
# PRIVACY_LLM_AUTO_ON_IMAGE=true

# 低置信/冲突时 LLM 仲裁
# PRIVACY_LLM_ENABLE_ARBITRATION=true
# PRIVACY_LLM_CONFIDENCE_THRESHOLD=0.75

# 规则引擎 LRU 缓存 / Rule engine & classification cache sizes
# PRIVACY_ENGINE_CACHE_MAX_SIZE=4096
# PRIVACY_CLASSIFICATION_CACHE_SIZE=10000

# 分类规则目录 / Rules directory & hot-reload settings
# PRIVACY_DYNCLASSIFICATION_RULES_DIR=rules
# PRIVACY_DYNCLASSIFICATION_HOT_RELOAD=true
# PRIVACY_DYNCLASSIFICATION_RELOAD_INTERVAL=0


# ==============================================================================
# 7. LLM 资源保护与推理 / LLM Resource Guardrails & Inference
# ==============================================================================
# 进程级 LLM 推理并发上限（信号量，防 OOM）/ Process-wide LLM concurrency cap
# PRIVACY_LLM_MAX_CONCURRENCY=1

# 等待推理槽位超时（秒），超时自动降级 / Semaphore wait timeout
# PRIVACY_LLM_SEMAPHORE_WAIT_SECONDS=30

# 可用内存低于阈值（MB）时跳过 LLM 层 / Skip LLM when free memory < threshold
# PRIVACY_LLM_MIN_FREE_MEM_MB=512

# VLM/LLM 单次推理超时（秒）/ Single inference timeout
# PRIVACY_VLM_TIMEOUT=180

# LLM 后端选择 / Backend selection: auto|pytorch|vllm|mlx|openai
# PRIVACY_LLM_BACKEND=auto


# ==============================================================================
# 8. 图片打码与网关 / Image Redaction & Gateway
# ==============================================================================
# 图片打码目录白名单（os.pathsep 分隔）/ Allowed dirs for image redaction
# PRIVACY_IMAGE_ALLOWED_DIRS=/data/images

# 网关配置文件路径（仅 gateway 模式）/ Gateway config (gateway mode only)
# PRIVACY_GATEWAY_CONFIG=config/gateway.yaml
